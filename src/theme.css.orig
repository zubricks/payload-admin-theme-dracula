/*
 * DRACULA FOR PAYLOAD
 * -------------------
 * Dark mode uses Dracula Classic. Light mode uses the official Alucard companion palette.
 * Palette and UI guidance: https://draculatheme.com/spec
 */

html[data-admin-theme="dracula"] {
  --field-border-radius: 0.5rem;
  --button-radius: 0.5rem;
  --popup-radius: 0.75rem;
  --popup-item-radius: 0.375rem;
  --accessibility-focus-color: #815cd6;
}

/* Alucard Classic — the official light companion to Dracula. */
html[data-admin-theme="dracula"][data-theme="light"],
html[data-admin-theme="dracula"] [data-theme="light"] {
  /* Core palette */
  --dracula-background: #fffbeb;
  --dracula-current-line: #6c664b;
  --dracula-selection: #cfcfde;
  --dracula-foreground: #1f1f1f;
  --dracula-comment: #6c664b;
  --dracula-red: #cb3a2a;
  --dracula-orange: #a34d14;
  --dracula-yellow: #846e15;
  --dracula-green: #14710a;
  --dracula-cyan: #036a96;
  --dracula-purple: #644ac9;
  --dracula-pink: #a3144d;

  /* Payload brand and component accents */
  --color-bg-brand: var(--dracula-purple);
  --color-bg-brand-hover: #7862d0;
  --color-bg-brand-pressed: var(--dracula-purple);
  --color-bg-brand-secondary: var(--dracula-purple);
  --color-bg-brand-tertiary: var(--dracula-selection);
  --color-bg-brand-tertiary-hover: #dedccf;
  --color-bg-component: var(--dracula-pink);
  --color-bg-component-tertiary: #efeddc;
  --color-bg-component-tertiary-hover: #dedccf;

  /* Surfaces */
  --color-bg: var(--dracula-background);
  --color-bg-elevated: #efeddc;
  --color-bg-hover: #ece9df;
  --color-bg-pressed: #dedccf;
  --color-bg-secondary: #efeddc;
  --color-bg-secondary-hover: #ece9df;
  --color-bg-secondary-pressed: #dedccf;
  --color-bg-tertiary: #ece9df;
  --color-bg-disabled: #dedccf;
  --color-bg-inverse: #2c2b31;
  --color-bg-inverse-hover: var(--dracula-foreground);
  --color-bg-inverse-pressed: #2c2b31;
  --color-bg-menu: #2c2b31;
  --color-bg-tooltip: #2c2b31;
  --color-bg-transparent-hover: rgb(100 74 201 / 10%);
  --color-bg-transparent-pressed: rgb(100 74 201 / 18%);

  /* Selection */
  --color-bg-selected: var(--dracula-selection);
  --color-bg-selected-hover: #dedccf;
  --color-bg-selected-pressed: #ceccc0;
  --color-bg-selected-strong: var(--dracula-purple);
  --color-bg-selected-strong-hover: #7862d0;
  --color-bg-selected-strong-pressed: var(--dracula-purple);

  /* Status */
  --color-bg-danger: var(--dracula-red);
  --color-bg-danger-hover: #d74c3d;
  --color-bg-danger-pressed: var(--dracula-red);
  --color-bg-danger-tertiary: #efeddc;
  --color-bg-danger-tertiary-hover: #dedccf;
  --color-bg-info: var(--dracula-cyan);
  --color-bg-success: var(--dracula-green);
  --color-bg-success-hover: #198d0c;
  --color-bg-success-pressed: var(--dracula-green);
  --color-bg-success-tertiary: #efeddc;
  --color-bg-success-tertiary-hover: #dedccf;
  --color-bg-warning: var(--dracula-yellow);
  --color-bg-warning-pressed: #9e841a;
  --color-bg-warning-tertiary: #efeddc;
  --color-bg-warning-tertiary-hover: #dedccf;

  /* Borders */
  --color-border: #dedccf;
  --color-border-hover: var(--dracula-current-line);
  --color-border-strong: #6c664b;
  --color-border-disabled: #ceccc0;
  --color-border-brand: #7862d0;
  --color-border-brand-strong: var(--dracula-purple);
  --color-border-component: var(--dracula-pink);
  --color-border-component-strong: var(--dracula-pink);
  --color-border-danger: #d74c3d;
  --color-border-danger-strong: var(--dracula-red);
  --color-border-selected: #7862d0;
  --color-border-selected-strong: var(--dracula-purple);
  --color-border-success: #198d0c;
  --color-border-success-strong: var(--dracula-green);
  --color-border-warning: #9e841a;
  --color-border-warning-strong: var(--dracula-yellow);
  --color-border-onbrand-strong: var(--dracula-background);

  /* Text and icons */
  --color-text: var(--dracula-foreground);
  --color-text-secondary: var(--dracula-comment);
  --color-text-tertiary: var(--dracula-comment);
  --color-text-disabled: var(--dracula-comment);
  --color-text-brand: var(--dracula-purple);
  --color-text-brand-secondary: var(--dracula-purple);
  --color-text-component: var(--dracula-pink);
  --color-text-component-pressed: var(--dracula-pink);
  --color-text-danger: var(--dracula-red);
  --color-text-success: var(--dracula-green);
  --color-text-warning: var(--dracula-yellow);
  --color-text-selected: var(--dracula-purple);
  --color-text-onbrand: var(--dracula-background);
  --color-text-onbrand-secondary: var(--dracula-background);
  --color-text-oncomponent: var(--dracula-background);
  --color-text-ondanger: var(--dracula-background);
  --color-text-onsuccess: var(--dracula-background);
  --color-text-onwarning: var(--dracula-background);
  --color-text-onselected-strong: var(--dracula-background);
  --color-text-oninverse: var(--dracula-background);
  --color-text-ontooltip: var(--dracula-background);
  --color-icon: var(--dracula-foreground);
  --color-icon-hover: var(--dracula-foreground);
  --color-icon-secondary: var(--dracula-comment);
  --color-icon-tertiary: var(--dracula-comment);
  --color-icon-disabled: var(--dracula-comment);
  --color-icon-brand: var(--dracula-purple);
  --color-icon-component: var(--dracula-pink);
  --color-icon-danger: var(--dracula-red);
  --color-icon-success: var(--dracula-green);
  --color-icon-warning: var(--dracula-yellow);
  --color-icon-selected: var(--dracula-purple);
  --color-icon-onbrand: var(--dracula-background);
  --color-icon-oncomponent: var(--dracula-background);
  --color-icon-ondanger: var(--dracula-background);
  --color-icon-onsuccess: var(--dracula-background);
  --color-icon-onselected-strong: var(--dracula-background);

  /* Translucent treatments */
  --special-bg-transparent: rgb(255 251 235 / 82%);
  --special-border-translucent: rgb(108 102 75 / 22%);
  --special-border-translucent-strong: rgb(108 102 75 / 38%);
}

/* Dracula Classic. */
html[data-admin-theme="dracula"][data-theme="dark"],
html[data-admin-theme="dracula"] [data-theme="dark"] {
  /* Core palette */
  --dracula-background: #282a36;
  --dracula-current-line: #6272a4;
  --dracula-selection: #44475a;
  --dracula-foreground: #f8f8f2;
  --dracula-comment: #6272a4;
  --dracula-red: #ff5555;
  --dracula-orange: #ffb86c;
  --dracula-yellow: #f1fa8c;
  --dracula-green: #50fa7b;
  --dracula-cyan: #8be9fd;
  --dracula-purple: #bd93f9;
  --dracula-pink: #ff79c6;
  --accessibility-focus-color: #bd93f9;

  /* Payload brand and component accents */
  --color-bg-brand: var(--dracula-purple);
  --color-bg-brand-hover: #d6acff;
  --color-bg-brand-pressed: var(--dracula-purple);
  --color-bg-brand-secondary: var(--dracula-purple);
  --color-bg-brand-tertiary: var(--dracula-selection);
  --color-bg-brand-tertiary-hover: #424450;
  --color-bg-component: var(--dracula-pink);
  --color-bg-component-tertiary: var(--dracula-selection);
  --color-bg-component-tertiary-hover: #424450;

  /* Surfaces */
  --color-bg: var(--dracula-background);
  --color-bg-elevated: #343746;
  --color-bg-hover: #343746;
  --color-bg-pressed: var(--dracula-selection);
  --color-bg-secondary: #343746;
  --color-bg-secondary-hover: #424450;
  --color-bg-secondary-pressed: var(--dracula-selection);
  --color-bg-tertiary: #424450;
  --color-bg-disabled: var(--dracula-selection);
  --color-bg-inverse: var(--dracula-foreground);
  --color-bg-inverse-hover: #ffffff;
  --color-bg-inverse-pressed: var(--dracula-foreground);
  --color-bg-menu: #21222c;
  --color-bg-tooltip: #191a21;
  --color-bg-transparent-hover: rgb(189 147 249 / 10%);
  --color-bg-transparent-pressed: rgb(189 147 249 / 18%);

  /* Selection */
  --color-bg-selected: var(--dracula-selection);
  --color-bg-selected-hover: #424450;
  --color-bg-selected-pressed: var(--dracula-current-line);
  --color-bg-selected-strong: var(--dracula-purple);
  --color-bg-selected-strong-hover: #d6acff;
  --color-bg-selected-strong-pressed: var(--dracula-purple);

  /* Status */
  --color-bg-danger: var(--dracula-red);
  --color-bg-danger-hover: #ff6e6e;
  --color-bg-danger-pressed: var(--dracula-red);
  --color-bg-danger-tertiary: var(--dracula-selection);
  --color-bg-danger-tertiary-hover: #424450;
  --color-bg-info: var(--dracula-cyan);
  --color-bg-success: var(--dracula-green);
  --color-bg-success-hover: #69ff94;
  --color-bg-success-pressed: var(--dracula-green);
  --color-bg-success-tertiary: var(--dracula-selection);
  --color-bg-success-tertiary-hover: #424450;
  --color-bg-warning: var(--dracula-yellow);
  --color-bg-warning-pressed: #ffffa5;
  --color-bg-warning-tertiary: var(--dracula-selection);
  --color-bg-warning-tertiary-hover: #424450;

  /* Borders */
  --color-border: var(--dracula-selection);
  --color-border-hover: var(--dracula-current-line);
  --color-border-strong: var(--dracula-current-line);
  --color-border-disabled: var(--dracula-selection);
  --color-border-brand: var(--dracula-purple);
  --color-border-brand-strong: #d6acff;
  --color-border-component: var(--dracula-pink);
  --color-border-component-strong: #ff92df;
  --color-border-danger: var(--dracula-red);
  --color-border-danger-strong: #ff6e6e;
  --color-border-selected: var(--dracula-purple);
  --color-border-selected-strong: #d6acff;
  --color-border-success: var(--dracula-green);
  --color-border-success-strong: #69ff94;
  --color-border-warning: var(--dracula-yellow);
  --color-border-warning-strong: #ffffa5;
  --color-border-onbrand-strong: #21222c;

  /* Text and icons */
  --color-text: var(--dracula-foreground);
  --color-text-secondary: var(--dracula-foreground);
  --color-text-tertiary: var(--dracula-comment);
  --color-text-disabled: var(--dracula-comment);
  --color-text-brand: var(--dracula-purple);
  --color-text-brand-secondary: var(--dracula-purple);
  --color-text-component: var(--dracula-pink);
  --color-text-component-pressed: #ff92df;
  --color-text-danger: var(--dracula-red);
  --color-text-success: var(--dracula-green);
  --color-text-warning: var(--dracula-yellow);
  --color-text-selected: var(--dracula-purple);
  --color-text-onbrand: #21222c;
  --color-text-onbrand-secondary: #21222c;
  --color-text-oncomponent: #21222c;
  --color-text-ondanger: #21222c;
  --color-text-onsuccess: #21222c;
  --color-text-onwarning: #21222c;
  --color-text-onselected-strong: #21222c;
  --color-text-oninverse: #21222c;
  --color-text-ontooltip: var(--dracula-foreground);
  --color-icon: var(--dracula-foreground);
  --color-icon-hover: var(--dracula-foreground);
  --color-icon-secondary: var(--dracula-foreground);
  --color-icon-tertiary: var(--dracula-comment);
  --color-icon-disabled: var(--dracula-comment);
  --color-icon-brand: var(--dracula-purple);
  --color-icon-component: var(--dracula-pink);
  --color-icon-danger: var(--dracula-red);
  --color-icon-success: var(--dracula-green);
  --color-icon-warning: var(--dracula-yellow);
  --color-icon-selected: var(--dracula-purple);
  --color-icon-onbrand: #21222c;
  --color-icon-oncomponent: #21222c;
  --color-icon-ondanger: #21222c;
  --color-icon-onsuccess: #21222c;
  --color-icon-onselected-strong: #21222c;

  /* Translucent treatments */
  --special-bg-transparent: rgb(40 42 54 / 82%);
  --special-border-translucent: rgb(98 114 164 / 28%);
  --special-border-translucent-strong: rgb(98 114 164 / 48%);
}

html[data-admin-theme="dracula"] ::selection {
  background: var(--dracula-selection);
  color: var(--dracula-foreground);
}
